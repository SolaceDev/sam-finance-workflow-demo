# Solace Agent Mesh Environment Variables

# LLM Gateway API Key (e.g. OpenRouter, OpenAI, or LiteLLM)
OPENROUTER_API_KEY=
LLM_SERVICE_API_KEY=

# Optional: Override target namespace (defaults to finance_demo)
# SAM_NAMESPACE=finance_demo

# Optional: Override SAM Platform URL (defaults to http://127.0.0.1:8800)
# SAM_PLATFORM_URL=http://127.0.0.1:8800
